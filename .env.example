# 3D Hands — desktop app (Python) configuration
# Author: Matheus Siqueira <https://www.matheussiqueira.dev>
#
# core/config.py reads these as environment variables (it does not load a .env
# file by itself). Set them in your shell or with your own env loader.
# The web version in public/ needs no environment variables.

# Camera
GESTURE_CAMERA_INDEX=0
GESTURE_FRAME_WIDTH=1280
GESTURE_FRAME_HEIGHT=720
GESTURE_TARGET_FPS=30

# Hand detection
GESTURE_MAX_HANDS=1
GESTURE_DETECTION_CONF=0.6
GESTURE_TRACKING_CONF=0.5
# Optional path to a local hand_landmarker.task
GESTURE_HAND_MODEL_PATH=

# Gesture timing (seconds)
GESTURE_RESET_HOLD_SEC=2.0
GESTURE_SWAP_HOLD_SEC=1.0
GESTURE_COLOR_HOLD_SEC=0.6

# Classifier training (debug app: python -m app.main)
GESTURE_CLASSIFIER=random_forest
GESTURE_TRAIN_SAMPLES=200

# Logging
GESTURE_DEBUG=false
GESTURE_LOG_PATH=logs/gesture_ai.log
